{
  "name": "damu-companion",
  "version": "1.0.0",
  "description": "Damu - a desktop companion that reminds you to drink water and take breaks.",
  "main": "src/main.js",
  "author": "abidkakkur11",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/abidkakkur11/damu-companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abidkakkur11/damu-companion.git"
  },
  "bugs": {
    "url": "https://github.com/abidkakkur11/damu-companion/issues"
  },
  "keywords": [
    "electron",
    "desktop-companion",
    "reminders",
    "hydration",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/companion.js && node --check src/settings.js && node --check src/preload.js && node --check src/preload-settings.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "icon": "node scripts/make-icon.js",
    "avatar": "node scripts/process-avatar.mjs",
    "process:v1": "node scripts/process-new-damu.js"
  },
  "build": {
    "appId": "net.expedigit.damu",
    "productName": "Damu",
    "copyright": "Copyright © 2026 abidkakkur11",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!assets/v1/**",
      "!assets/poses/*.png",
      "!assets/audio/README.txt",
      "!assets/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Damu",
      "uninstallDisplayName": "Damu",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "afterPack": "scripts/after-pack.js"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.33.5"
  }
}
