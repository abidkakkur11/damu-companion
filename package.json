{
  "name": "damu-companion",
  "version": "0.1.0",
  "description": "Damu - a desktop companion that reminds you to drink water and take breaks.",
  "main": "src/main.js",
  "author": "abidkakkur11",
  "license": "MIT",
  "private": true,
  "scripts": {
    "avatar": "node scripts/process-avatar.mjs",
    "process:v1": "node scripts/process-new-damu.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "net.expedigit.damu",
    "productName": "Damu",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.33.5"
  }
}
