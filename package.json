{
  "name": "damu-companion",
  "version": "2.0.0",
  "description": "Damu - a desktop companion who drops by with dialogues, reacts to your mouse and sits around. For Windows and macOS.",
  "main": "src/main.js",
  "author": {
    "name": "Abid KP",
    "url": "https://abidkp.com"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/abidkakkur11/damu-companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abidkakkur11/damu-companion.git"
  },
  "bugs": {
    "url": "https://github.com/abidkakkur11/damu-companion/issues"
  },
  "keywords": [
    "electron",
    "desktop-companion",
    "desktop-pet",
    "windows",
    "macos"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/companion.js && node --check src/settings.js && node --check src/preload.js && node --check src/preload-settings.js",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win --publish never",
    "icon": "node scripts/make-icon.js",
    "avatar": "node scripts/process-avatar.mjs",
    "process:v1": "node scripts/process-new-damu.js",
    "pack:mac": "electron-builder --mac --dir --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "net.expedigit.damu",
    "productName": "Damu",
    "copyright": "Copyright © 2026 Abid KP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!assets/v1/**",
      "!assets/poses/*.png",
      "!assets/audio/README.txt",
      "!assets/icon.ico",
      "!assets/icon-mac.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Damu",
      "uninstallDisplayName": "Damu",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Damu-Setup-${version}.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.lifestyle",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Damu ${version}",
      "contents": [
        {
          "x": 130,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "Damu-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.33.5"
  }
}
